{
  "name": "city-of-tides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:perspective": "node --import tsx _qa/perspective-director.ts",
    "test:continuity": "node --import tsx _qa/continuity-gate.ts",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:shared-world": "node --import tsx _qa/shared-world-engine.ts",
    "test:grant-inventory": "node --import tsx _qa/player-inventory.ts",
    "test:grant-cloud": "node _qa/grant-cloud-flow.mjs",
    "test:production-backend": "node _qa/production-backend.mjs",
    "test:release-visual": "node --import tsx _qa/release-visual.ts",
    "test:protocol": "node --import tsx _qa/protocol.ts",
    "test:danger": "node --import tsx _qa/danger-director.ts",
    "test:state-integrity": "node --import tsx _qa/state-integrity.ts",
